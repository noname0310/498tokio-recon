    "preview": "node scripts/serve.cjs",
    "check:runtime": "node tests/check-runtime.cjs",
    "check:noise": "node tests/check-procedural.cjs && node tests/check-noise.cjs",
    "check:atlas": "node tests/check-atlas.cjs && node tests/check-sprite-effects.cjs",
    "check:sprite-effects": "node tests/check-sprite-effects.cjs",
    "check:particles": "node tests/check-particles.cjs",
    "check:intro": "node tests/check-intro.cjs",
    "check:starfield": "node tests/check-starfield.cjs",
    "check:forward": "node tests/check-forward.cjs",
    "check:transitions": "node tests/check-transitions.cjs && node tests/check-fade.cjs",
    "check:paper": "node tests/check-paper.cjs",
    "check:landscape": "node tests/check-landscape.cjs",
    "check:frame": "node tests/check-viewport-frame.cjs",
    "check:interior": "node tests/check-interior.cjs",
    "check:helmet": "node tests/check-helmet.cjs && node tests/check-dom-compositing.cjs",
    "check:perspective": "node tests/check-perspective.cjs",
    "check:dom-depth": "node tests/check-dom-depth.cjs",
    "format:json": "node scripts/format-json.cjs",
    "check:json": "node scripts/format-json.cjs --check",
    "check:types": "node scripts/check-types.cjs && tsc --noEmit",
    "build": "webpack --mode production",
    "build:standalone": "webpack --mode production --env standalone",
    "build:watch": "webpack --mode development --env site --watch",
    "prepreview": "npm run build",
    "check:animation": "node tests/check-animation.cjs",
    "check:player": "node tests/check-player.cjs",
    "check:audio-seek": "node tests/check-audio-seek.cjs",
    "check:pinwheel": "node tests/check-pinwheel.cjs",
    "check:dist": "node tests/check-dist.cjs",
    "check:loading": "node tests/check-loading.cjs",
    "check:startup": "node tests/check-startup.cjs && node tests/check-progressive-startup.cjs",
    "check:images": "node tests/check-image-preparation.cjs",
    "check:standalone": "node tests/check-standalone.cjs",
    "prebuild": "npm run check:types",
    "prebuild:standalone": "npm run check:types",
    "prebuild:watch": "npm run check:types",
    "check:lifetimes": "node tests/check-lifetimes.cjs",
    "check:preparation": "node tests/check-preparation.cjs",
    "check:asteroid": "node tests/check-asteroid.cjs",
    "check:babylon-reuse": "node tests/check-babylon-reuse.cjs",
    "check:deck": "node tests/check-deck.cjs && npm run check:planar-depth && npm run check:camera-blur && npm run check:sorting-group && npm run check:line-rays",
    "check:line-rays": "node tests/check-line-rays.cjs",
    "check:sorting-group": "node tests/check-sorting-group.cjs",
    "check:camera-blur": "node tests/check-camera-blur.cjs",
    "check:planar-depth": "node tests/check-planar-depth.cjs",
    "check:boss": "node tests/check-boss.cjs",
    "check:evasion": "node tests/check-evasion.cjs",
    "check:destruction": "node tests/check-destruction.cjs && node tests/check-depth-of-field.cjs && node tests/check-annulus.cjs",
    "check:return": "node tests/check-return.cjs",
    "check:paper-return": "node tests/check-paper-return.cjs",
    "check:flashback": "node tests/check-flashback.cjs && node tests/check-scanline-jitter.cjs",
    "check:biome": "node tests/check-biome.cjs",
    "check:landing": "node tests/check-landing.cjs",
    "check:memory": "node tests/check-childhood-memory.cjs",
    "check:storm": "node tests/check-storm.cjs && node tests/check-colored-vignette.cjs",
    "check:secondary-texture": "node tests/check-secondary-texture.cjs",
    "check:text": "node tests/check-text.cjs",
    "check:ending": "node tests/check-ending.cjs",
    "check:color-gradient": "node tests/check-color-gradient.cjs && node tests/check-tile-blur.cjs",
    "check:tile-blur": "node tests/check-tile-blur.cjs",
    "check:seek": "node tests/check-seek-rendering.cjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.27.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "copy-webpack-plugin": "14.0.0",
    "fracturedjsonjs": "5.0.2",
    "html-inline-script-webpack-plugin": "3.2.1",
    "html-loader": "5.1.0",
    "html-webpack-plugin": "5.6.8",
    "playwright": "1.61.0",
    "terser-webpack-plugin": "5.6.1",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "worker-rspack-loader": "3.1.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
